# Mounadev Communication Hub - Production Environment
# Copy to .env.production and fill in real values

# Server
PORT=3001
NODE_ENV=production
HUB_API_KEY=REPLACE_WITH_STRONG_KEY

# Supabase
SUPABASE_URL=https://nwefybjvisfrzowtxfkj.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_WITH_SERVICE_KEY

# OpenWA (WhatsApp provider)
OPENWA_BASE_URL=http://localhost:2785
OPENWA_SESSION=7224dc3e-1fce-4712-bd32-e23ff410dc90
OPENWA_API_KEY=REPLACE_WITH_API_KEY

# Webhook
WEBHOOK_SECRET=REPLACE_WITH_STRONG_SECRET

# Rate Limits (production)
RATE_LIMIT_AGENT_DAILY=20
RATE_LIMIT_AGENT_HOURLY=5
RATE_LIMIT_CONTACT_DAILY=3
RATE_LIMIT_CONTACT_HOURLY=1
RATE_LIMIT_GLOBAL_DAILY=100
RATE_LIMIT_GLOBAL_HOURLY=15

# Security
CORS_ORIGIN=https://your-dashboard-domain.com
ENABLE_HELMET=true
LOG_LEVEL=info
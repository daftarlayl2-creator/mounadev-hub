# Caissa Communication Hub - Environment Variables
# Copy to .env and fill in values

# Server
PORT=3001
NODE_ENV=development
HUB_API_KEY=caissa_hub_master_key_change_me

# Supabase
SUPABASE_URL=https://nwefybjvisfrzowtxfkj.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# OpenWA (WhatsApp provider)
OPENWA_BASE_URL=http://localhost:2785
OPENWA_SESSION=mounade5
OPENWA_API_KEY=your_openwa_api_key_here

# Webhook
WEBHOOK_SECRET=your_webhook_secret_here

# Rate Limits
RATE_LIMIT_AGENT_DAILY=20
RATE_LIMIT_AGENT_HOURLY=5
RATE_LIMIT_CONTACT_DAILY=3
RATE_LIMIT_CONTACT_HOURLY=1
RATE_LIMIT_GLOBAL_DAILY=100
RATE_LIMIT_GLOBAL_HOURLY=15

# Hermes AI (LLM backend for WhatsApp auto-reply)
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=your_hermes_api_key_here
HERMES_MODEL=hermes-agent

# WhatsApp Business Agent
WHATSAPP_AGENT_ID=sami
WHATSAPP_AUTO_REPLY=true
